# ==============================================================================
# CareerIQ AI — Environment Configuration Example
# ==============================================================================
# Copy this file to .env before starting the server:
#   cp .env.example .env
#
# Server Configuration
PORT=3000
NODE_ENV=development

# Gemini API Configuration (Server-Side Only)
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Leave blank or set your key. If omitted, CareerIQ uses deterministic fallback models.
GEMINI_API_KEY=

# Applet Dev Configuration (Do not modify in AI Studio preview)
# DISABLE_HMR=true
